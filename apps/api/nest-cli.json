{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "tsc",
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      {
        "include": "matching/data/*.json",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  }
}
